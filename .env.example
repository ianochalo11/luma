# Environment template — copy to `.env.local`

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth (optional — enables real Google sign-in)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# MongoDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=Cluster0
MONGODB_DB=luma

# Initial admin email (promoted to isAdmin on sign-in / seed)
ADMIN_EMAIL=lumacentre545@gmail.com

# Resend (required for email OTP sign-in)
# from must be: email@example.com  OR  Name <email@example.com>
# For local/dev without a verified domain, use: Luma <onboarding@resend.dev>
RESEND_API_KEY=
RESEND_FROM=Luma <onboarding@resend.dev>

# Solana (reserved for a real RPC swap; checkout uses mock USDC today)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# Passkeys (WebAuthn) use AUTH_URL as the relying party origin.
# Sign in from the modal via discoverable passkeys; register under Settings → Add a passkey.
