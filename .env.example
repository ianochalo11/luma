# Environment template — copy to `.env.local`

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth (optional — enables real Google sign-in)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# MongoDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=Cluster0
MONGODB_DB=luma

# Initial admin email (promoted to isAdmin on sign-in / seed)
ADMIN_EMAIL=josephwamiti8711@gmail.com

# Solana (mock by default; unused until real RPC swap)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
